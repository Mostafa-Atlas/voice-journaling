# Create a bot at https://discord.com/developers/applications and rotate any
# credential that has ever appeared in source code.
DISCORD_TOKEN=<replace-me>
GROQ_API_KEY=<replace-me>

# Comma-separated Discord user IDs permitted to use the private bot.
ALLOWED_USER_IDS=<replace-me>

# Paths are resolved relative to the project unless absolute.
DATA_ROOT=.
VOICE_LOG_DIR=voice_logs
DATABASE_PATH=transcripts.db
LOG_DIR=logs

SUMMARY_MODEL=openai/gpt-oss-120b
SUMMARY_MODEL_FALLBACK=openai/gpt-oss-20b
TRANSCRIPTION_MODEL=whisper-large-v3
# Optional ISO-639-1 hint such as en or ar; empty enables auto-detection.
TRANSCRIPTION_LANGUAGE=
MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_JOBS=2
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_RETRIES=2

TIMEZONE=Africa/Cairo
OBSIDIAN_VAULT_PATH=/mnt/obsidian-vault
OBSIDIAN_SUBFOLDER=Voice Journal
OBSIDIAN_REQUIRE_MOUNT=true
OBSIDIAN_QUEUE_CHECK_SECONDS=300

# Zero means the manual prune command requires --days. Cleanup is always a
# dry-run unless the operator explicitly adds --execute.
RETENTION_DAYS=0
LOG_LEVEL=INFO
